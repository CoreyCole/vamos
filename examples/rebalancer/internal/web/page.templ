package web

templ Layout(data PageData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Portfolio Rebalancer</title>
			<script src="https://cdn.tailwindcss.com"></script>
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.1/bundles/datastar.js"></script>
		</head>
		<body class="bg-gray-50 min-h-screen">
			<div class="container mx-auto px-4 py-8 max-w-7xl">
				<header class="mb-8">
					<h1 class="text-3xl font-bold text-gray-900">Household Portfolio Rebalancer</h1>
					<p class="text-gray-600 mt-2">Multi-account position management and rebalancing</p>
				</header>
				<main data-init="@get('/events')">
					<div id="ingest-status"></div>
					@MainContent(data)
				</main>
			</div>
		</body>
	</html>
}

templ MainContent(data PageData) {
	<div id="rebalancer-main" class="space-y-6">
		<!-- Controls -->
		<div class="bg-white rounded-lg shadow p-6">
			<h2 class="text-xl font-semibold mb-4">Controls</h2>
			<div class="flex gap-4">
				<button
					class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700"
					data-on:click="@post('/ingest', {contentType: 'form'})"
				>
					Load Positions
				</button>
			</div>
		</div>
		<!-- Targets -->
		@Targets(data)
		<!-- Summary -->
		@Summary(data)
		<!-- Positions -->
		@Positions(data)
		<!-- Trades -->
		@Trades(data)
	</div>
}

templ IngestStatus(status, message string) {
	<div id="ingest-status">
		if status != "" {
			<div class={ "mb-6 p-4 rounded-lg", templ.KV("bg-green-50 border border-green-200", status == "success"), templ.KV("bg-red-50 border border-red-200", status == "error") }>
				<p class={ "text-sm font-medium", templ.KV("text-green-800", status == "success"), templ.KV("text-red-800", status == "error") }>
					{ message }
				</p>
			</div>
		}
	</div>
}

templ Targets(data PageData) {
	<div id="targets" class="bg-white rounded-lg shadow p-6">
		<h2 class="text-xl font-semibold mb-4">Target Allocation</h2>
		<form class="space-y-4">
			<div class="grid grid-cols-2 md:grid-cols-3 gap-4">
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">US Equity (%)</label>
					<input
						type="number"
						name="wUs"
						min="0"
						max="100"
						step="1"
						value={ formatFloat(data.Targets.USEquity) }
						data-model="wUs"
						data-on-input.debounce_500ms="@post('/rebalance', {contentType: 'form'})"
						class="w-full px-3 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500"
					/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Intl Equity (%)</label>
					<input
						type="number"
						name="wIntl"
						min="0"
						max="100"
						step="1"
						value={ formatFloat(data.Targets.IntlEquity) }
						data-model="wIntl"
						data-on-input.debounce_500ms="@post('/rebalance', {contentType: 'form'})"
						class="w-full px-3 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500"
					/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Thematic Equity (%)</label>
					<input
						type="number"
						name="wThematic"
						min="0"
						max="100"
						step="1"
						value={ formatFloat(data.Targets.ThematicEquity) }
						data-model="wThematic"
						data-on-input.debounce_500ms="@post('/rebalance', {contentType: 'form'})"
						class="w-full px-3 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500"
					/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Gold (%)</label>
					<input
						type="number"
						name="wGold"
						min="0"
						max="100"
						step="1"
						value={ formatFloat(data.Targets.Gold) }
						data-model="wGold"
						data-on-input.debounce_500ms="@post('/rebalance', {contentType: 'form'})"
						class="w-full px-3 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500"
					/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Short Duration (%)</label>
					<input
						type="number"
						name="wShort"
						min="0"
						max="100"
						step="1"
						value={ formatFloat(data.Targets.ShortDuration) }
						data-model="wShort"
						data-on-input.debounce_500ms="@post('/rebalance', {contentType: 'form'})"
						class="w-full px-3 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500"
					/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Cash (%)</label>
					<input
						type="number"
						name="wCash"
						min="0"
						max="100"
						step="1"
						value={ formatFloat(data.Targets.Cash) }
						data-model="wCash"
						data-on-input.debounce_500ms="@post('/rebalance', {contentType: 'form'})"
						class="w-full px-3 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500"
					/>
				</div>
			</div>
		</form>
	</div>
}

templ Summary(data PageData) {
	<div id="summary" class="bg-white rounded-lg shadow p-6">
		<h2 class="text-xl font-semibold mb-4">Portfolio Mix</h2>
		<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
			<div>
				<div class="text-sm text-gray-600">Total Value</div>
				<div class="text-2xl font-bold">${ formatMoney(data.TotalValue) }</div>
			</div>
			if len(data.ClassBreakdown) > 0 {
				for _, cb := range data.ClassBreakdown {
					<div>
						<div class="text-sm text-gray-600">{ cb.Class }</div>
						<div class="text-lg font-semibold">{ formatFloat(cb.CurrentPct) }%</div>
						if cb.TargetPct > 0 {
							<div class="text-xs text-gray-500">Target: { formatFloat(cb.TargetPct) }%</div>
						}
					</div>
				}
			}
		</div>
		if len(data.Blockers) > 0 {
			<div class="mt-4 p-4 bg-yellow-50 border border-yellow-200 rounded">
				<h3 class="font-medium text-yellow-900 mb-2">Constraints</h3>
				<ul class="list-disc list-inside text-sm text-yellow-800 space-y-1">
					for _, b := range data.Blockers {
						<li>{ b }</li>
					}
				</ul>
			</div>
		}
	</div>
}

templ Positions(data PageData) {
	<div id="positions" class="bg-white rounded-lg shadow p-6">
		<div class="flex justify-between items-center mb-4">
			<h2 class="text-xl font-semibold">Positions</h2>
			<div class="flex gap-2">
				<select
					name="listShows"
					data-model="listShows"
					data-on-change="@post('/positions', {contentType: 'form'})"
					class="px-3 py-1 border border-gray-300 rounded text-sm"
				>
					<option value="value" selected?={ data.ListShows == "value" }>Market Value</option>
					<option value="quantity" selected?={ data.ListShows == "quantity" }>Quantity</option>
					<option value="price" selected?={ data.ListShows == "price" }>Last Price</option>
				</select>
				<select
					name="sortBy"
					data-model="sortBy"
					data-on-change="@post('/positions', {contentType: 'form'})"
					class="px-3 py-1 border border-gray-300 rounded text-sm"
				>
					<option value="value" selected?={ data.SortBy == "value" }>Sort by Value</option>
					<option value="account" selected?={ data.SortBy == "account" }>Sort by Account</option>
					<option value="class" selected?={ data.SortBy == "class" }>Sort by Class</option>
					<option value="symbol" selected?={ data.SortBy == "symbol" }>Sort by Symbol</option>
				</select>
			</div>
		</div>
		if len(data.Positions) == 0 {
			<p class="text-gray-500 text-center py-8">No positions loaded. Click "Load Positions" to start.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="min-w-full divide-y divide-gray-200">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Account</th>
							<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Symbol</th>
							<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
							<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Class</th>
							<th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">
								if data.ListShows == "quantity" {
									Quantity
								} else if data.ListShows == "price" {
									Price
								} else {
									Value
								}
							</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						for _, p := range data.Positions {
							<tr>
								<td class="px-4 py-3 text-sm text-gray-900">{ p.Account }</td>
								<td class="px-4 py-3 text-sm font-medium text-gray-900">{ p.Symbol }</td>
								<td class="px-4 py-3 text-sm text-gray-600">{ p.Name }</td>
								<td class="px-4 py-3 text-sm text-gray-600">{ p.AssetClass }</td>
								<td class="px-4 py-3 text-sm text-gray-900 text-right">
									if data.ListShows == "quantity" {
										{ formatFloat(p.Quantity) }
									} else if data.ListShows == "price" {
										${ formatMoney(p.Price) }
									} else {
										${ formatMoney(p.MarketValue) }
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

templ Trades(data PageData) {
	<div id="trades" class="bg-white rounded-lg shadow p-6">
		<h2 class="text-xl font-semibold mb-4">Proposed Trades</h2>
		if len(data.Trades) == 0 {
			<p class="text-gray-500 text-center py-8">No trades proposed. Adjust target allocation to generate trades.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="min-w-full divide-y divide-gray-200">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Account</th>
							<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Side</th>
							<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Symbol</th>
							<th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Shares</th>
							<th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Dollars</th>
							<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Reason</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						for _, t := range data.Trades {
							<tr>
								<td class="px-4 py-3 text-sm text-gray-900">{ t.Account }</td>
								<td class="px-4 py-3 text-sm">
									<span class={ "px-2 py-1 rounded text-xs font-medium", templ.KV("bg-green-100 text-green-800", t.Side == "BUY"), templ.KV("bg-red-100 text-red-800", t.Side == "SELL") }>
										{ t.Side }
									</span>
								</td>
								<td class="px-4 py-3 text-sm font-medium text-gray-900">{ t.Symbol }</td>
								<td class="px-4 py-3 text-sm text-gray-900 text-right">{ formatInt(t.RoundedShares) }</td>
								<td class="px-4 py-3 text-sm text-gray-900 text-right">${ formatMoney(t.Dollars) }</td>
								<td class="px-4 py-3 text-sm text-gray-600">{ t.Reason }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}
