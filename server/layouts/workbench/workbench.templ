package workbench

templ Workbench(state WorkbenchState) {
	<div
		id="workbench-root"
		data-signals={ EncodeWorkbenchSignals(state) }
		data-workbench-page={ string(state.Page) }
		data-workbench-view={ string(state.View) }
		data-workbench-viewport-class={ string(state.ViewportClass) }
		data-workbench-mobile-active={ SignalKeyForID(state.Config.Mobile.ActiveRegionID) }
		data-attr:data-workbench-focused="$workbench.focused ? 'true' : 'false'"
		class="flex h-full min-h-0 w-full overflow-hidden p-2 md:p-4"
	>
		<script type="module" src="/js/workbench-resize.js?v=8"></script>
		<script type="module" src="/js/workbench-history.js?v=22"></script>
		<script type="module" src="/js/workbench-doc-scroll.js?v=3"></script>
		<script defer src="/js/frame-comment-bridge.js?v=4" data-commentui-mode="parent"></script>
		<div class="flex min-h-0 w-full flex-col gap-2 overflow-hidden">
			@MobileRegionTabs(state)
			<div id="workbench-regions" class="flex min-h-0 w-full flex-1 gap-2 overflow-hidden">
				for index, region := range state.Regions {
					@Region(state, region)
					if CanResizeAfter(state, index) {
						@ResizeHandle(region, NextVisibleSignalKey(state, index))
					}
				}
			</div>
		</div>
	</div>
}

// ThreadsReopenControl — icon control for the chat header row when left rail is closed.
// Hard lock: never a band above the chat column / above the 3-col grid.
templ ThreadsReopenControl(threadsOpen bool) {
	// Keep a fixed icon slot so #workbench-v2-chat-header height does not jump.
	// Invisible (not display:none) when left is open; no max-md:hidden.
	<div
		id="workbench-v2-threads-reopen"
		class={ "workbench-chrome flex h-7 w-7 shrink-0 items-center justify-center", templ.KV("invisible pointer-events-none", threadsOpen) }
		data-class={ "{'invisible': $workbench.regions.workbenchV2Threads.visible, 'pointer-events-none': $workbench.regions.workbenchV2Threads.visible}" }
		aria-hidden={ threadsOpenAriaHidden(threadsOpen) }
	>
		<button
			type="button"
			data-workbench-threads-reopen
			class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-border bg-background text-muted-foreground shadow-sm transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
			data-on:click={ ThreadsShowClickAction("workbenchV2Threads") }
			aria-controls="workbench-v2-threads"
			aria-label="Show threads sidebar"
			title="Show threads sidebar"
		>
			<svg class="h-4 w-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
		</button>
	</div>
}

// ChatColumnWithReopen wraps middle-column chat with an in-shell chat header row.
// Threads reopen lives in that header (same row as title) — never a strip above.
templ ChatColumnWithReopen(threadsOpen bool, title string, chat templ.Component) {
	<div class="flex h-full min-h-0 flex-col bg-background">
		<header id="workbench-v2-chat-header" class="flex h-10 shrink-0 items-center gap-2 border-b border-border px-2.5">
			@ThreadsReopenControl(threadsOpen)
			<div class="min-w-0 flex-1">
				if title != "" {
					<p class="truncate text-[13px] font-semibold leading-tight text-foreground">{ title }</p>
				}
			</div>
		</header>
		<div class="flex min-h-0 flex-1 flex-col overflow-hidden">
			@chat
		</div>
	</div>
}
