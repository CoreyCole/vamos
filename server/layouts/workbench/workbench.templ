package workbench

templ Workbench(state WorkbenchState) {
	<div
		id="workbench-root"
		data-signals={ EncodeWorkbenchSignals(state) }
		data-workbench-page={ string(state.Page) }
		data-workbench-view={ string(state.View) }
		data-workbench-viewport-class={ string(state.ViewportClass) }
		data-workbench-mobile-active={ SignalKeyForID(state.Config.Mobile.ActiveRegionID) }
		data-attr:data-workbench-focused="$workbench.focused ? 'true' : 'false'"
		data-on:keydown__window={ ThreadsToggleHotkeyAction() }
		class="flex h-full min-h-0 w-full overflow-hidden p-0"
	>
		<script type="module" src="/js/workbench-resize.js?v=16"></script>
		<script type="module" src="/js/workbench-history.js?v=23"></script>
		<script type="module" src="/js/workbench-doc-scroll.js?v=3"></script>
		<script defer src="/js/frame-comment-bridge.js?v=4" data-commentui-mode="parent"></script>
		<div class="flex min-h-0 w-full flex-col gap-0 overflow-hidden">
			if state.MobileChatCommentsHeader {
				@MobileChatCommentsHeader(state)
			}
			<div id="workbench-regions" class="flex min-h-0 w-full flex-1 gap-0 overflow-hidden">
				for index, region := range state.Regions {
					@Region(state, region)
					if CanResizeAfter(state, index) {
						@ResizeHandle(region, NextVisibleSignalKey(state, index))
					}
				}
			</div>
		</div>
		if state.MobileChatCommentsHeader {
			@MobileCommentsSheet()
		}
	</div>
}

// ThreadsReopenControl — icon control for the chat header row when left rail is closed.
// Hard lock: never a band above the chat column / above the 3-col grid.
templ ThreadsReopenControl(threadsOpen bool, controlID string) {
	<div
		id={ controlID }
		class={ "workbench-chrome flex h-7 w-7 shrink-0 items-center justify-center", templ.KV("hidden", threadsOpen) }
		data-class={ ThreadsReopenDataClass() }
		aria-hidden={ threadsOpenAriaHidden(threadsOpen) }
	>
		<button
			type="button"
			data-workbench-threads-reopen
			class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-border bg-background text-muted-foreground shadow-sm transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
			data-on:click={ ThreadsShowClickAction("workbenchV2Threads") }
			aria-controls="workbench-v2-threads"
			aria-label={ ThreadsShowControlTitle() }
			title={ ThreadsShowControlTitle() }
		>
			<svg class="h-4 w-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
		</button>
	</div>
}

// ArtifactReopenControl — desktop reopen when artifact pane is closed (Grok-like Open details).
// Lives in chat header; path-header Close details is md:flex only (no second mobile >>).
templ ArtifactReopenControl(artifactOpen bool, controlID string) {
	<div
		id={ controlID }
		class={ "workbench-chrome flex h-7 shrink-0 items-center justify-center", templ.KV("hidden", artifactOpen) }
		data-class={ ArtifactReopenDataClass() }
		aria-hidden={ artifactOpenAriaHidden(artifactOpen) }
	>
		<button
			type="button"
			data-testid="artifact-open-details"
			class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-border bg-background text-muted-foreground shadow-sm transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
			data-on:click={ ArtifactShowClickAction() }
			aria-controls="workbench-v2-artifact"
			aria-label={ ArtifactShowControlTitle() }
			title={ ArtifactShowControlTitle() }
		>
			<span aria-hidden="true" class="font-mono text-[11px] leading-none">&lt;&lt;</span>
			<span class="sr-only">Open details</span>
		</button>
	</div>
}

// ChatColumnWithReopen wraps middle-column chat with an in-shell chat header row.
// Threads reopen lives in that header (same row as title) — never a strip above.
// overflow is the single desktop ⋯ menu (Share + optional Artifact); nil => Share stubs only.
templ ChatColumnWithReopen(threadsOpen bool, artifactOpen bool, title string, chat templ.Component, overflow templ.Component) {
	@ChatColumnWithReopenMark(threadsOpen, artifactOpen, title, false, chat, overflow)
}

// ChatColumnWithPlanReopen is ChatColumnWithReopen with a color swatch (no letter/number glyph).
templ ChatColumnWithPlanReopen(threadsOpen bool, artifactOpen bool, title string, chat templ.Component, overflow templ.Component) {
	@ChatColumnWithReopenMark(threadsOpen, artifactOpen, title, true, chat, overflow)
}

templ ChatColumnWithReopenMark(threadsOpen bool, artifactOpen bool, title string, planSwatch bool, chat templ.Component, overflow templ.Component) {
	<div class="flex h-full min-h-0 flex-col bg-background">
		<header id="workbench-v2-chat-header" class="hidden h-10 min-h-10 max-h-10 shrink-0 items-center gap-2 overflow-hidden border-b border-border px-2.5 md:flex">
			@ThreadsReopenControl(threadsOpen, "workbench-v2-threads-reopen")
			if title != "" {
				if planSwatch {
					<span
						class={ "h-2.5 w-2.5 shrink-0 rounded-full", ChatHeaderPlanSwatchClass(title) }
						aria-hidden="true"
						data-chat-plan-swatch
					></span>
				} else {
					<span class={ "flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-[11px] font-semibold", ChatHeaderAvatarClass(title) }>{ ChatHeaderInitial(title) }</span>
				}
			}
			<div class="flex min-h-0 min-w-0 flex-1 items-center gap-2">
				if title != "" {
					{{ parts := ParseChatHeaderTitle(title) }}
					<p class="min-w-0 flex-1 truncate text-[13px] font-semibold leading-none text-foreground">{ parts.Display }</p>
					if parts.Datetime != "" {
						<span class="shrink-0 text-[11px] tabular-nums leading-none text-muted-foreground">{ parts.Datetime }</span>
					}
				}
			</div>
			@ArtifactReopenControl(artifactOpen, "workbench-v2-artifact-reopen")
			if overflow != nil {
				@overflow
			} else {
				@ChatHeaderShareOverflow()
			}
		</header>
		<div class="flex min-h-0 flex-1 flex-col overflow-hidden">
			@chat
		</div>
	</div>
}
