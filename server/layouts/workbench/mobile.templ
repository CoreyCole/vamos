package workbench

templ MobileChatCommentsHeader(state WorkbenchState) {
	<div
		id="workbench-mobile-chat-comments"
		class="workbench-chrome flex shrink-0 items-center gap-2 md:hidden"
	>
		@ThreadsReopenControl(threadsRegionVisible(state), "workbench-mobile-threads-reopen")
		<button
			type="button"
			data-testid="mobile-toggle-chat"
			class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
			data-on:click={ ChatToggleClickAction() }
			data-attr:aria-pressed="$workbench.regions.workbenchV2Chat.visible ? 'true' : 'false'"
			data-class="{ 'bg-muted text-foreground': $workbench.regions.workbenchV2Chat.visible }"
			aria-controls="workbench-v2-chat"
			aria-label="View Chat"
			title="View Chat"
		>
			<svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
			</svg>
		</button>
		<button
			type="button"
			data-testid="mobile-toggle-comments"
			class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
			data-on:click={ CommentsToggleClickAction() }
			data-attr:aria-pressed="$workbench.regions.workbenchV2Comments.visible ? 'true' : 'false'"
			data-class="{ 'bg-muted text-foreground': $workbench.regions.workbenchV2Comments.visible }"
			aria-controls="workbench-v2-comments"
			aria-label="Toggle comments"
			title="Toggle comments"
		>
			<svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
			</svg>
		</button>
	</div>
}

templ MobileRegionTabs(state WorkbenchState) {
	<div
		id="workbench-mobile-tabs"
		class="workbench-chrome flex shrink-0 items-center gap-2 md:hidden"
		role="tablist"
		aria-label="Workbench regions"
	>
		for _, region := range state.Regions {
			{{ selected := SignalKey(region) == SignalKeyForID(state.Config.Mobile.ActiveRegionID) }}
			<button
				type="button"
				class={
					"rounded-md border border-border bg-background px-3 py-1.5 text-xs font-medium text-muted-foreground shadow-sm transition-colors hover:text-foreground",
					templ.KV("bg-muted text-foreground", selected),
				}
				data-show={ "$workbench.normalRegions." + SignalKey(region) + ".available" }
				data-on:click={ mobileRegionTabClick(region) }
				data-class={ "{'bg-muted text-foreground': $workbench.activeRegionID === '" + SignalKey(region) + "'}" }
				data-attr:aria-selected={ "$workbench.activeRegionID === '" + SignalKey(region) + "' ? 'true' : 'false'" }
				if selected {
					aria-selected="true"
				} else {
					aria-selected="false"
				}
				aria-controls={ region.TargetID }
				role="tab"
			>
				{ mobileRegionLabel(region) }
			</button>
		}
	</div>
}
