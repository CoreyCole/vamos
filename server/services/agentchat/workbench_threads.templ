package agentchat

templ WorkbenchThreadList(groups []WorkbenchThreadGroup, selectedID, artifact string) {
	<div class="flex h-full min-h-0 flex-col bg-background" data-signals="{threadSearch: ''}">
		<div class="flex items-center gap-2 border-b border-border p-3">
			<button
				type="button"
				data-workbench-threads-toggle
				class="hidden h-9 w-9 shrink-0 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring md:inline-flex"
				data-on:click="$workbench.regions.workbenchV2Threads.visible = false"
				data-attr:aria-expanded="$workbench.regions.workbenchV2Threads.visible ? 'true' : 'false'"
				aria-controls="workbench-v2-threads"
				aria-label="Hide threads sidebar"
				title="Hide threads sidebar"
			>
				<svg class="h-4 w-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
			</button>
			<label for="workbench-thread-search" class="sr-only">Search threads</label>
			<input id="workbench-thread-search" type="search" placeholder="Search threads" class="min-w-0 flex-1 rounded-md border border-input bg-background px-3 py-2 text-sm" data-bind="threadSearch"/>
		</div>
		<nav class="min-h-0 flex-1 overflow-y-auto p-2" aria-label="Threads">
			for _, group := range groups {
				<details
					data-thread-project-folder
					class="group mb-1"
					open
					data-show={ "!$threadSearch || " + threadGroupSearchMatch(group.Threads) }
					data-effect={ "$threadSearch && " + threadGroupSearchMatch(group.Threads) + " ? (el.open = true) : null" }
				>
					<summary class="flex min-h-11 cursor-pointer select-none list-none items-center gap-1.5 rounded-md px-2 text-xs font-semibold text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 [&::-webkit-details-marker]:hidden">
						<svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-90" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
						</svg>
						<svg class="h-4 w-4 shrink-0" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
							<path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"></path>
						</svg>
						<span data-thread-project-label class="min-w-0 truncate">{ group.Label }</span>
					</summary>
					<div class="ml-3 space-y-0.5 border-l border-border pl-1">
						for _, thread := range group.Threads {
							<a href={ templ.URL(threadWorkbenchHref(thread.ID, artifact)) } data-show={ "!$threadSearch || " + threadSearchMatch(thread.Title) } class={ "block truncate rounded-md px-2 py-2 text-sm hover:bg-muted", templ.KV("bg-muted font-medium text-foreground", thread.ID == selectedID), templ.KV("text-muted-foreground", thread.ID != selectedID) }>{ thread.Title }</a>
						}
					</div>
				</details>
			}
		</nav>
	</div>
}

templ SharedThreadChat(args EmbeddedFreeformPanelArgs) {
	<div class="flex h-full min-h-0 flex-col bg-background">
		if args.StreamURL != "" {
			<div class="hidden" data-init={ "@get('" + args.StreamURL + "')" }></div>
		}
		<div id="agent-chat-scroll-region" class="flex min-h-0 flex-1 flex-col overflow-y-auto overflow-x-hidden">
			@MessagesPane(args.ThreadID, args.Transcript, args.HasThread, freeformForkAction(args.ThreadID))
		</div>
		<div class="shrink-0 border-t border-border bg-background p-3">
			@AgentChatComposer(AgentChatComposerArgs{Action: args.ComposerAction, ThreadID: args.ThreadID, RunID: args.RunID, Cwd: args.Cwd, ModeLabel: embeddedFreeformModeLabel(args.ThreadMetadata), Placeholder: workspacePromptPlaceholder(args.HasThread), HasThread: args.HasThread, IncludeCwd: !args.HasThread, ThreadMetadata: args.ThreadMetadata, InitialDraft: args.InitialDraft, DraftSaveAction: args.DraftSaveAction})
		</div>
	</div>
}
