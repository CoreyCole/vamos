package agentchat

templ HermesThreadsPanel(args HermesThreadsPanelArgs) {
	<div id="hermes-threads-panel" class="flex h-full min-h-0 flex-col bg-background" data-signals={ "{threadSearch: '', threadPlan: '" + args.PlanDir + "', threadPlanManual: false, threadFreeform: false, threadContext: ['" + args.CurrentFile + "'], newThreadOpen: false}" }>
		<div class="shrink-0 space-y-2 border-b border-border p-3">
			<div class="flex items-center justify-between gap-2">
				<p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Shared threads</p>
				<button type="button" class="rounded-md bg-primary px-2 py-1 text-xs font-medium text-primary-foreground" data-on:click="$newThreadOpen = true">New Thread</button>
			</div>
			<input name="query" class="w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm" placeholder="Search all thread names" data-bind="threadSearch"/>
		</div>
		<div class="min-h-0 flex-1 overflow-y-auto p-3">
			for _, group := range GroupHermesThreads(args.Threads) {
				<section class="mb-4">
					<p class="mb-1 truncate text-xs font-medium text-muted-foreground">{ group.PlanDir }</p>
					for _, thread := range group.Threads {
						<button type="button" class="mb-1 flex w-full flex-col rounded-md border border-border px-2 py-2 text-left hover:bg-muted" data-on:click="$rightRailActiveTab = 'chat'">
							<span class="truncate text-sm font-medium text-foreground">{ thread.Title }</span>
							<span class="truncate text-xs text-muted-foreground">{ thread.OwnerEmail }</span>
						</button>
					}
				</section>
			}
			if len(args.Threads) == 0 {
				<p class="text-sm text-muted-foreground">No shared threads found for this plan.</p>
			}
		</div>
		<div data-show="$newThreadOpen" class="absolute inset-0 z-10 flex items-end bg-black/30 p-3">
			<div class="w-full space-y-3 rounded-lg border border-border bg-popover p-3 shadow-lg">
				<div class="flex items-center justify-between"><p class="font-medium">New Thread</p><button type="button" data-on:click="$newThreadOpen = false">Close</button></div>
				<div class="flex flex-wrap gap-1"><template data-for="path in $threadContext"><span class="rounded-full border border-border px-2 py-0.5 text-xs"><span data-text="$path"></span><button type="button" class="ml-1" data-on:click="$threadContext = $threadContext.filter(value => value !== $path); if (!$threadPlanManual && $threadContext.length === 0) $threadPlan = ''">×</button></span></template></div>
				<input class="w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm" placeholder="Add context file" data-on:keydown="if (evt.key === 'Enter' && el.value.trim()) { evt.preventDefault(); $threadContext = [...$threadContext, el.value.trim()]; el.value = '' }"/>
				<label class="block text-xs text-muted-foreground">Plan<input class="mt-1 w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm" data-bind="threadPlan" data-on:input="$threadPlanManual = true" placeholder="Infer from context, or leave blank"/></label>
				<label class="flex items-center gap-2 text-sm"><input type="checkbox" data-bind="threadFreeform"/> Freeform thread</label>
				<p class="text-xs text-muted-foreground">Removing all plan context makes this an explicit freeform thread. A manual plan choice stays unchanged.</p>
			</div>
		</div>
	</div>
}
