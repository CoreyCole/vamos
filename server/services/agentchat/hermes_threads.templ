package agentchat

templ HermesThreadsPanel(args HermesThreadsPanelArgs) {
	<div id="hermes-threads-panel" class="flex h-full min-h-0 flex-col bg-background">
		<div class="shrink-0 border-b border-border px-3 py-2">
			<p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Shared Hermes threads</p>
			if args.PlanDir != "" {
				<p class="truncate text-xs text-muted-foreground">{ args.PlanDir }</p>
			}
		</div>
		if args.NoPlan {
			<div class="flex min-h-0 flex-1 items-center justify-center p-4 text-sm text-muted-foreground">
				Open a document or directory inside a plan to view its Hermes threads.
			</div>
		} else {
			<div class="grid min-h-0 flex-1 grid-rows-[auto_1fr]">
				<div class="max-h-48 overflow-y-auto border-b border-border p-2">
					if len(args.Threads) == 0 {
						<p class="p-2 text-sm text-muted-foreground">No shared threads found for this plan.</p>
					}
					for _, thread := range args.Threads {
						<a
							href={ templ.SafeURL(args.ThreadHrefs[thread.ID]) }
							class={ "mb-1 flex w-full flex-col rounded-md border px-2 py-2 text-left transition-colors hover:bg-muted", templ.KV("border-primary bg-muted", thread.ID == args.SelectedID), templ.KV("border-border", thread.ID != args.SelectedID) }
						>
							<span class="truncate text-sm font-medium text-foreground">{ thread.Title }</span>
							<span class="truncate text-xs text-muted-foreground">Created by { thread.CreatorEmail }</span>
						</a>
					}
				</div>
				<div id="hermes-thread-transcript" class="min-h-0 overflow-y-auto p-3">
					if args.SelectedID == "" {
						<p class="text-sm text-muted-foreground">Select a thread to inspect its transcript.</p>
					} else {
						<div class="mb-3 border-b border-border pb-2">
							<p class="text-sm font-medium text-foreground">{ args.SelectedTitle }</p>
							if args.CanPrompt {
								<p class="text-xs text-muted-foreground">You have prompt authority. Prompt controls are not available in this read-only view.</p>
							} else {
								<p class="text-xs text-muted-foreground">Shared read-only transcript.</p>
							}
						</div>
						if len(args.Messages) == 0 {
							<p class="text-sm text-muted-foreground">This thread has no transcript turns yet.</p>
						}
						<div class="space-y-3">
							for _, message := range args.Messages {
								@ChatMessage(message)
							}
						</div>
					}
				</div>
			</div>
		}
	</div>
}
