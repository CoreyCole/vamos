package agentchat

// iMessage/Grok bubble chrome ported from agenthome fixtures into SharedThreadChat.

templ BubbleAvatar(initial string, bgClass string) {
	<span class={ "flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-[10px] font-semibold text-white", bgClass }>{ initial }</span>
}

templ BubbleAuthorName(name string, colorClass string) {
	<p class={ "mb-0.5 text-[11px] font-semibold leading-none", colorClass }>{ name }</p>
}

templ NestedQuoteBlock(initial string, name string, avatarBg string, nameColor string, quote string) {
	<div class="mb-1.5 rounded-lg bg-black/40 px-2 py-1.5" data-role="quote">
		<div class="mb-1 flex items-center gap-1.5">
			<span class={ "flex h-4 w-4 shrink-0 items-center justify-center rounded-full text-[8px] font-semibold text-white", avatarBg }>{ initial }</span>
			<span class={ "text-[11px] font-semibold", nameColor }>{ name }</span>
		</div>
		<p class="text-[11px] leading-snug text-white/80">{ quote }</p>
	</div>
}

templ bubbleBodyInner(args ChatMessageArgs) {
	if args.QuoteText != "" {
		@NestedQuoteBlock(
			args.QuoteInitial,
			args.QuoteName,
			args.QuoteAvatarBg,
			args.QuoteNameColor,
			args.QuoteText,
		)
	}
	if args.Role == "user" {
		<div class="whitespace-pre-wrap break-words text-[13px] leading-snug text-white">{ args.Content }</div>
	} else if args.HTMLContent != "" {
		<div class="markdown-viewer chat-message-content min-w-0 break-words text-[13px] leading-snug text-white [&_pre]:overflow-x-auto [&_pre]:rounded-lg [&_pre]:!bg-black/40 [&_pre]:text-[12px]" data-ignore>
			@templ.Raw(args.HTMLContent)
		</div>
	} else {
		<div class="whitespace-pre-wrap break-words text-[13px] leading-snug text-white">{ args.Content }</div>
	}
}
