package markdown

templ ThreadArtifactPane(browser ThreadArtifactBrowserArgs, document templ.Component) {
	<div
		id="thread-artifact-pane"
		class="flex h-full min-h-0 flex-col bg-background"
		data-signals={ "{_threadArtifactLoading: false, _artifactBrowserOpen: " + boolString(browser.BrowserOpen) + ", dirSearch: '', _dirSearchOpen: false}" }
		data-on:keydown__window={ artifactBrowserSearchHotkeyAction() }
		data-attr:aria-busy="$_threadArtifactLoading ? 'true' : 'false'"
		data-attr:data-artifact-browser-open="$_artifactBrowserOpen ? '1' : '0'"
		if browser.BrowserOpen {
			data-artifact-browser-open="1"
		} else {
			data-artifact-browser-open="0"
		}
	>
		<div id="thread-artifact-path-header" class="flex h-10 min-h-10 max-h-10 shrink-0 items-center gap-2 overflow-hidden border-b border-border px-2.5 text-xs">
			if browser.ViewDocumentHref != "" {
				if browser.DocumentViewActive {
					<a
						href={ templ.URL(browser.ViewDocumentHref) }
						data-testid="view-chat"
						data-on:click={ commentsCloseCookieJS() }
						class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
						aria-label="View Chat"
						title="View Chat"
					>
						<svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
						</svg>
					</a>
				} else {
					<button
						type="button"
						data-testid="view-chat"
						class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
						data-on:click={ chatToggleClickAction() }
						data-attr:aria-pressed="$workbench.regions.workbenchV2Chat.visible ? 'true' : 'false'"
						data-class="{ 'bg-muted text-foreground': $workbench.regions.workbenchV2Chat.visible }"
						aria-controls="workbench-v2-chat"
						aria-label="View Chat"
						title="View Chat"
					>
						<svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
						</svg>
					</button>
				}
			}
			<button
				type="button"
				data-testid="view-comments"
				class={
					"inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground",
					templ.KV("bg-muted text-foreground", browser.CommentsOpen),
				}
				data-on:click={ commentsToggleClickAction(browser) }
				data-attr:aria-pressed="$workbench.regions.workbenchV2Comments.visible ? 'true' : 'false'"
				data-class="{ 'bg-muted text-foreground': $workbench.regions.workbenchV2Comments.visible }"
				aria-controls="workbench-v2-comments"
				aria-label="Toggle comments"
				title="Toggle comments"
				if browser.CommentsOpen {
					aria-pressed="true"
				} else {
					aria-pressed="false"
				}
			>
				<svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
				</svg>
			</button>
			@ThreadArtifactUp(browser)
			@ThreadArtifactPath(browser)
			<input
				id="artifact-browser-search"
				type="search"
				data-bind="dirSearch"
				data-testid="artifact-browser-search"
				data-show="$_dirSearchOpen"
				data-on:input__debounce.300ms={ artifactBrowserSearchFetchAction() }
				data-on:keydown={ artifactBrowserSearchKeydownAction() }
				data-on:blur={ artifactBrowserSearchBlurAction() }
				placeholder="Search"
				aria-label="Search files"
				class="h-7 min-w-0 flex-1 rounded-md border border-transparent bg-transparent px-1.5 text-xs text-foreground outline-none focus:border-ring focus:ring-2 focus:ring-ring"
				style="display: none;"
			/>
			<button
				type="button"
				data-testid="artifact-browser-search-toggle"
				data-on:click={ artifactBrowserSearchFocusAction() }
				data-show="!$_dirSearchOpen"
				data-attr:aria-pressed="$_dirSearchOpen ? 'true' : 'false'"
				class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
				aria-label="Search files"
				title="Search files (Ctrl+K)"
				aria-pressed="false"
			>
				<svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z"></path>
				</svg>
			</button>
			<button
				type="button"
				data-testid="artifact-browser-search-clear"
				data-on:click={ artifactBrowserSearchClearAction() }
				data-show="$_dirSearchOpen"
				class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
				aria-label="Clear search"
				title="Clear search (Esc)"
				style="display: none;"
			>
				<svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
			<button
				type="button"
				data-testid="artifact-browser-toggle"
				class={
					"inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground",
					templ.KV("bg-muted text-foreground", browser.BrowserOpen),
				}
				data-on:click={ artifactBrowserToggleAction() }
				data-on:keydown={ artifactBrowserToggleKeydownAction() }
				data-attr:aria-expanded="$_artifactBrowserOpen ? 'true' : 'false'"
				data-attr:aria-pressed="$_artifactBrowserOpen ? 'true' : 'false'"
				data-class="{ 'bg-muted text-foreground': $_artifactBrowserOpen }"
				data-attr:data-artifact-browser-open="$_artifactBrowserOpen ? '1' : '0'"
				aria-controls="thread-artifact-browser"
				aria-label="Toggle files"
				title="Toggle files (Ctrl+L)"
				if browser.BrowserOpen {
					aria-expanded="true"
					aria-pressed="true"
					data-artifact-browser-open="1"
				} else {
					aria-expanded="false"
					aria-pressed="false"
					data-artifact-browser-open="0"
				}
			>
				<svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						data-attr:d="$_artifactBrowserOpen ? 'M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v2M3 7v10a2 2 0 002 2h14a2 2 0 002-2V11M3 11h18' : 'M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z'"
						if browser.BrowserOpen {
							d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v2M3 7v10a2 2 0 002 2h14a2 2 0 002-2V11M3 11h18"
						} else {
							d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"
						}
					></path>
				</svg>
			</button>
			if browser.HeaderActions != nil {
				@browser.HeaderActions
			}
		</div>
		@ThreadArtifactBrowser(browser)
		<div id="thread-artifact-document" class="min-h-0 flex-1 overflow-auto" aria-live="polite">
			@document
		</div>
	</div>
}

templ ThreadArtifactBrowser(browser ThreadArtifactBrowserArgs) {
	<nav
		id="thread-artifact-browser"
		data-thread-artifact-browser
		data-thread-artifact-cwd={ threadArtifactDirectoryIdentity(browser.DirectoryPath) }
		data-artifact-search-endpoint={ thoughtsArtifactSearchEndpoint(browser.ThreadID, browser.DocPath, browser.DirectoryPath) }
		data-show={ artifactBrowserVisibleExpr() }
		class="min-h-0 max-h-64 shrink-0 overflow-y-auto border-b border-border"
		aria-label="Artifact browser"
	>
		@ThreadArtifactBrowserResults(ThreadArtifactBrowserResultsArgs{Entries: browser.Entries})
	</nav>
}

templ ThreadArtifactPath(browser ThreadArtifactBrowserArgs) {
	<span
		id="thread-artifact-path-slot"
		data-testid="artifact-browser-path"
		data-show="!$_dirSearchOpen"
		class="min-w-0 flex-1 overflow-hidden text-muted-foreground"
	>
		<span
			data-testid="artifact-browser-file"
			data-show="!$_artifactBrowserOpen"
			dir="rtl"
			class="block overflow-hidden text-ellipsis whitespace-nowrap text-left"
			title={ artifactHeaderFileTitle(browser.DocPath) }
			if browser.BrowserOpen {
				style="display: none;"
			}
		><span dir="ltr">{ artifactHeaderFileTitle(browser.DocPath) }</span></span>
		<span
			data-testid="artifact-browser-cwd"
			data-show="$_artifactBrowserOpen"
			dir="rtl"
			class="block overflow-hidden text-ellipsis whitespace-nowrap text-left"
			title={ threadArtifactDirectoryIdentity(browser.DirectoryPath) }
			if !browser.BrowserOpen {
				style="display: none;"
			}
		><span dir="ltr">{ threadArtifactDirectoryIdentity(browser.DirectoryPath) }</span></span>
	</span>
}

templ ThreadArtifactUp(browser ThreadArtifactBrowserArgs) {
	<div id="thread-artifact-up-slot" class="contents">
		if browser.ParentHref != "" {
			<a
				id="thread-artifact-up"
				href={ templ.URL(browser.ParentHref) }
				data-thread-artifact-up
				if browser.ParentEndpoint != "" {
					data-artifact-endpoint={ browser.ParentEndpoint }
					data-indicator="_threadArtifactLoading"
					data-on:click={ threadArtifactBrowserClickAction() }
				}
				class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
				aria-label="Open parent folder"
				title="Open parent folder"
			>
				<svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
				</svg>
			</a>
		}
	</div>
}

templ ThreadArtifactBrowserResults(args ThreadArtifactBrowserResultsArgs) {
	<div id="thread-artifact-browser-results" class="px-2.5 py-2" data-testid="artifact-browser-results" data-on:keydown={ artifactBrowserSearchResultsKeydownAction() }>
		if args.Query == "" {
			<ul class="space-y-0.5">
				for _, entry := range args.Entries {
					@ThreadArtifactBrowserEntry(entry)
				}
			</ul>
		} else {
			@artifactSearchSection("This directory", "artifact-search-this-directory", args.Directory, true)
			@artifactSearchSection("All thoughts", "artifact-search-all-thoughts", args.Global, true)
		}
	</div>
}

templ artifactSearchSection(title, testID string, hits []ArtifactSearchHit, showPath bool) {
	<section class="mb-2 last:mb-0" data-testid={ testID }>
		<h2 class="px-2 pb-1 text-[11px] font-medium uppercase tracking-wide text-muted-foreground">{ title }</h2>
		if len(hits) == 0 {
			<p class="px-2 py-1 text-xs italic text-muted-foreground">No matches</p>
		} else {
			<ul class="space-y-0.5">
				for _, hit := range hits {
					@artifactSearchHitRow(hit, showPath)
				}
			</ul>
		}
	</section>
}

templ artifactSearchHitRow(hit ArtifactSearchHit, showPath bool) {
	if hit.IsDir {
		@ThreadArtifactDirectory(artifactSearchHitEntry(hit))
	} else {
		<li class="relative z-0">
			<a
				href={ templ.URL(hit.Href) }
				data-thread-artifact-file
				class="relative z-0 block min-w-0 rounded-r px-2 py-1 text-xs text-muted-foreground transition-colors border-l-2 border-transparent hover:bg-muted/60 hover:text-foreground focus:bg-muted/60 focus:text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
			>
				<span class="block truncate">{ hit.Name }</span>
				if showPath {
					<span class="block truncate text-[10px] text-muted-foreground">{ threadArtifactDirectoryIdentity(hit.Path) }</span>
				}
			</a>
		</li>
	}
}

templ ThreadArtifactBrowserEntry(entry ThreadArtifactEntry) {
	if entry.IsDir {
		@ThreadArtifactDirectory(entry)
	} else {
		<li class="relative z-0">
			<a
				href={ templ.URL(entry.Href) }
				data-thread-artifact-file
				if entry.IsActive {
					aria-current="page"
				}
				class={
					"relative z-0 block min-w-0 truncate rounded-r px-2 py-1 text-xs transition-colors border-l-2 focus:outline-none focus:ring-2 focus:ring-ring",
					templ.KV("border-primary bg-muted font-medium text-foreground", entry.IsActive),
					templ.KV("border-transparent text-muted-foreground hover:bg-muted/60 hover:text-foreground focus:bg-muted/60 focus:text-foreground", !entry.IsActive),
				}
			>
				{ entry.Name }
			</a>
		</li>
	}
}

templ ThreadArtifactDirectory(entry ThreadArtifactEntry) {
	<li id={ entry.TargetID } class="relative z-0">
		<details
			class="group"
			if entry.IsExpanded {
				open
			}
			data-loaded={ threadArtifactLoaded(entry.IsLoaded) }
			data-artifact-endpoint={ entry.Endpoint }
			data-on:toggle={ threadArtifactDirectoryToggleAction() }
		>
			<summary
				data-thread-artifact-toggle
				class="flex min-h-8 cursor-pointer select-none items-center gap-1.5 rounded py-1 pl-2 pr-9 text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus:bg-muted focus:text-foreground focus:outline-none focus:ring-2 focus:ring-ring focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
				aria-controls={ threadArtifactChildrenID(entry) }
				title="Expand or collapse (Enter)"
			>
				<span class="group-open:hidden" aria-hidden="true">▸</span>
				<span class="hidden group-open:inline" aria-hidden="true">▾</span>
				<span class="truncate">{ entry.Name }/</span>
			</summary>
			<ul id={ threadArtifactChildrenID(entry) } class="ml-3 space-y-0.5 border-l border-border pl-1">
				for _, child := range entry.Children {
					@ThreadArtifactBrowserEntry(child)
				}
			</ul>
		</details>
		if entry.BrowseHref != "" {
			<a
				href={ templ.URL(entry.BrowseHref) }
				data-thread-artifact-enter
				if entry.BrowseEndpoint != "" {
					data-artifact-endpoint={ entry.BrowseEndpoint }
					data-indicator="_threadArtifactLoading"
					data-on:click={ threadArtifactBrowserClickAction() }
				}
				class="absolute right-1 top-0.5 z-10 inline-flex h-7 w-7 items-center justify-center rounded text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
				aria-label={ "Open " + entry.Name + " folder" }
				title={ "Open " + entry.Name + " folder" }
			>
				<svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
				</svg>
			</a>
		}
	</li>
}
