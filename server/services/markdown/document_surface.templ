package markdown

import (
	"path/filepath"
	"strings"

	"github.com/CoreyCole/vamos/server/services/commentui"
)

templ DocumentSurface(doc WorkbenchDocument) {
	<div id="document-surface" class="flex h-full min-h-0 flex-col overflow-hidden bg-background" data-signals={ encodePageSignals(doc.PageSessionID) }>
		<div id="thoughts-url-sync" class="hidden" aria-hidden="true"></div>
		<div id="thoughts-open-chat-result" class="hidden" aria-hidden="true"></div>
		if doc.RawMarkdown != "" {
			<template id={ documentCopySourceID }>{ doc.RawMarkdown }</template>
		}
		if doc.WorkbenchActions != nil {
			<div class="flex shrink-0 justify-end border-b border-border px-3 py-2">
				@doc.WorkbenchActions
			</div>
		}
		<div id="thoughts-markdown-scroll-region" class={ documentScrollRegionClass(doc.Kind) }>
			@QRSPIArtifactContext(doc.QRSPIMetadata)
			if doc.Component != nil {
				@doc.Component
			} else if doc.CommentMode == CommentModeSelectionOnly {
				@commentui.CommentableSelectionHTML(doc.CommentUI)
			} else {
				@commentui.CommentableMarkdown(doc.CommentUI)
			}
		</div>
		<div class="hidden" aria-hidden="true">
			@commentui.MobileSectionCommentTarget()
		</div>
	</div>
}

templ DocumentOnlyCommentSurface(component templ.Component, comments commentui.CommentableMarkdownArgs) {
	<div class={ documentOnlyCommentSurfaceClass(comments.DocPath) } data-commentui-container="true">
		@component
		@commentui.DocumentPatchTarget(comments, "Document")
	</div>
}

templ QRSPIArtifactContext(meta QRSPIMetadata) {
	if meta.Present {
		<section class="mb-3 overflow-hidden rounded-lg border border-border bg-background">
			<div class="flex flex-wrap items-center gap-2 px-3 py-2 text-xs text-muted-foreground">
				if meta.PlanTitle != "" {
					<span class="truncate rounded-md border border-border px-2 py-1 font-medium text-foreground">{ meta.PlanTitle }</span>
				}
				if meta.PlanDate != "" {
					<span class="rounded-md border border-border px-2 py-1">{ meta.PlanDate }</span>
				}
				if meta.PlanTime != "" {
					<span class="rounded-md border border-border px-2 py-1">{ meta.PlanTime }</span>
				}
				if meta.Ticket != "" {
					<span class="rounded-md border border-border px-2 py-1">{ meta.Ticket }</span>
				}
				if meta.Repository != "" {
					<span class="rounded-md border border-border px-2 py-1">{ meta.Repository }</span>
				}
				if !meta.UpdatedAt.IsZero() {
					<span class="rounded-md border border-border px-2 py-1">Updated { formatDate(meta.UpdatedAt) }</span>
				}
			</div>
			if len(meta.Nav) > 0 {
				<nav class="flex flex-wrap items-center gap-1 border-t border-border px-3 py-2 text-xs" aria-label="QRSPI flow">
					for i, item := range meta.Nav {
						if i > 0 {
							<span class="text-muted-foreground">→</span>
						}
						if item.Disabled {
							<span class="rounded-md px-2 py-1 text-muted-foreground/60">{ item.Label }</span>
						} else {
							<a href={ templ.SafeURL(item.Href) } data-on:click={ artifactBrowserCloseCookieJS() } class={ "rounded-md px-2 py-1 transition-colors hover:bg-muted", templ.KV("bg-muted font-medium text-foreground", item.Current), templ.KV("text-muted-foreground", !item.Current) }>{ item.Label }</a>
						}
					}
				</nav>
			}
		</section>
	}
}

func documentScrollRegionClass(kind DocumentKind) string {
	switch kind {
	case DocumentKindHTMLApplet:
		return "min-h-0 flex-1 overflow-hidden"
	case DocumentKindSource:
		return "min-h-0 flex-1 overflow-auto bg-muted/20"
	case DocumentKindCSVTable:
		return "min-h-0 flex-1 overflow-hidden flex flex-col px-3 py-1.5"
	default:
		return "min-h-0 flex-1 overflow-y-auto px-3 py-1.5"
	}
}

func documentOnlyCommentSurfaceClass(docPath string) string {
	switch strings.ToLower(filepath.Ext(docPath)) {
	case ".csv", ".tsv":
		return "relative flex min-h-0 min-w-0 flex-1 flex-col"
	default:
		return "relative h-full min-h-full min-w-0"
	}
}
