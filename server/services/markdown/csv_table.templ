package markdown

templ CSVTableDocument(docPath string, table CSVTable, label string) {
	{{ _ = docPath }}
	<section class="document-table-content w-full">
		if table.TooLarge {
			<p class="text-sm text-muted-foreground">{ table.Notice }</p>
		} else if len(table.Headers) == 0 {
			<p class="text-sm text-muted-foreground">Empty { label } file.</p>
		} else {
			<div class="table-wrapper">
				<table>
					<thead>
						<tr>
							for _, header := range table.Headers {
								<th class="px-4 py-3 text-left text-sm font-semibold text-foreground">
									@csvTableCellContent(header)
								</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, row := range table.Rows {
							<tr>
								for i := 0; i < len(table.Headers); i++ {
									if i < len(row) {
										<td class="px-4 py-3 text-sm text-foreground">
											@csvTableCellContent(row[i])
										</td>
									} else {
										<td class="px-4 py-3 text-sm text-muted-foreground"></td>
									}
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

templ csvTableCellContent(cell CSVCell) {
	if cell.html == "" {
		{ cell.Text }
	} else {
		@templ.Raw(cell.html)
	}
}
