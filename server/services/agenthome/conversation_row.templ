package agenthome

templ ConversationRow(row ConversationRowArgs) {
	<a
		if row.ID != "" {
			id={ row.ID }
		}
		href={ templ.SafeURL(row.Href) }
		if row.DataRosterID != "" {
			data-roster-id={ row.DataRosterID }
		}
		if row.DataRosterTitle != "" {
			data-roster-title={ row.DataRosterTitle }
		}
		if row.TestID != "" {
			data-testid={ row.TestID }
		}
		class={ rosterAgentRowClass(row.Selected) }
	>
		<span class={ "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-2xl text-xs font-semibold text-white", row.AccentClass }>{ row.Initial }</span>
		<span class="min-w-0 flex-1">
			<span class="flex items-baseline justify-between gap-2">
				<span class="truncate text-sm font-medium text-foreground">{ row.Title }</span>
				if row.Time != "" {
					<span class="shrink-0 text-[10px] text-muted-foreground">{ row.Time }</span>
				}
			</span>
			if row.Preview != "" {
				<span class="mt-0.5 block truncate text-xs text-muted-foreground">{ row.Preview }</span>
			}
		</span>
	</a>
}
