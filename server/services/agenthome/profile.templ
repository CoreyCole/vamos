package agenthome

import "github.com/CoreyCole/vamos/server/layouts/workbench"

templ ProfilePane(args ProfilePaneArgs) {
	<div id="agent-profile-pane" class="flex h-full min-h-0 flex-col bg-background">
		<header class="flex h-10 min-h-10 max-h-10 shrink-0 items-center gap-2 overflow-hidden border-b border-border px-2.5">
			<h2 class="min-w-0 flex-1 truncate text-[13px] font-semibold leading-none text-foreground">Details</h2>
			@workbench.ArtifactDetailsPrimaryControl()
			@workbench.ChatHeaderShareOverflow()
		</header>
		<div class="flex min-h-0 flex-1 flex-col gap-3 overflow-auto p-4">
			<p class="text-xs text-muted-foreground">Files on disk under thoughts/agents/{ args.Slug }/.</p>
			if len(args.Files) == 0 {
				<p id="agent-profile-empty" class="text-sm text-muted-foreground">No profile files on disk.</p>
			} else {
				<ul id="agent-profile-files" class="flex flex-col gap-1 text-sm">
					for _, file := range args.Files {
						<li>
							<a
								class="underline"
								href={ templ.SafeURL(ProfileGETPath(args.Kind, args.Slug, file.RelPath)) }
							>{ file.RelPath }</a>
						</li>
					}
				</ul>
			}
			if args.Selected != "" {
				<form
					id="agent-profile-edit"
					method="post"
					action={ templ.SafeURL(ProfilePOSTPath(args.Kind, args.Slug)) }
					class="flex min-h-0 flex-1 flex-col gap-2"
				>
					<input type="hidden" name="file" value={ args.Selected }/>
					<label class="text-xs text-muted-foreground" for="agent-profile-body">{ args.Selected }</label>
					<textarea
						id="agent-profile-body"
						name="body"
						class="min-h-48 w-full rounded-md border border-border bg-background p-2 font-mono text-sm"
					>{ args.Body }</textarea>
					<button type="submit" class="w-fit rounded-md border border-border px-3 py-1 text-sm">
						Save
					</button>
				</form>
			}
		</div>
	</div>
}
