package agenthome

// RosterContextMenu — Grok-like right-click menu (selection-aware labels).
templ RosterContextMenu() {
	<div
		id="workbench-v2-roster-context-menu"
		class="fixed z-[1000] min-w-[220px] rounded-xl border border-border bg-popover p-1 text-sm text-popover-foreground shadow-xl"
		style="display: none; left: 0px; top: 0px;"
		role="menu"
		aria-label="Roster actions"
	>
		<button type="button" role="menuitem" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-1.5 text-left hover:bg-muted/60" data-roster-action="pin">
			<span class="w-4 text-center text-muted-foreground" aria-hidden="true">📌</span>
			<span>Pin</span>
		</button>
		<button type="button" role="menuitem" class="flex w-full items-center justify-between gap-2 rounded-lg px-2.5 py-1.5 text-left hover:bg-muted/60" data-roster-action="move">
			<span class="flex items-center gap-2">
				<span class="w-4 text-center text-muted-foreground" aria-hidden="true">📁</span>
				<span data-roster-label="move">Move to</span>
			</span>
			<span class="text-muted-foreground" aria-hidden="true">›</span>
		</button>
		<button type="button" role="menuitem" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-1.5 text-left hover:bg-muted/60" data-roster-action="unread">
			<span class="w-4 text-center text-muted-foreground" aria-hidden="true">🔔</span>
			<span>Mark as Unread</span>
		</button>
		<div class="my-1 border-t border-border/60"></div>
		<button type="button" role="menuitem" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-1.5 text-left hover:bg-muted/60" data-roster-action="edit-profile" id="workbench-v2-roster-menu-edit-profile">
			<span class="w-4 text-center text-muted-foreground" aria-hidden="true">✎</span>
			<span>Edit Profile</span>
		</button>
		<button type="button" role="menuitem" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-1.5 text-left hover:bg-muted/60" data-roster-action="duplicate">
			<span class="w-4 text-center text-muted-foreground" aria-hidden="true">⧉</span>
			<span>Duplicate</span>
		</button>
		<div class="my-1 border-t border-border/60"></div>
		<button type="button" role="menuitem" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-1.5 text-left hover:bg-muted/60" data-roster-action="copy-id">
			<span class="w-4 text-center text-muted-foreground" aria-hidden="true">❏</span>
			<span>Copy conversation ID</span>
		</button>
		<div class="my-1 border-t border-border/60"></div>
		<button type="button" role="menuitem" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-1.5 text-left hover:bg-muted/60" data-roster-action="hide">
			<span class="w-4 text-center text-muted-foreground" aria-hidden="true">👁</span>
			<span data-roster-label="hide">Hide from sidebar</span>
		</button>
		<button type="button" role="menuitem" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-1.5 text-left text-destructive hover:bg-destructive/10" data-roster-action="delete">
			<span class="w-4 text-center" aria-hidden="true">🗑</span>
			<span data-roster-label="delete">Delete</span>
		</button>
	</div>
}

// EditProfileSheet — stub sheet opened from Edit Profile menu item.
templ EditProfileSheet() {
	<div
		id="workbench-v2-edit-profile-sheet"
		class="fixed inset-0 z-[1000] hidden items-center justify-center bg-black/60 p-4"
		role="dialog"
		aria-modal="true"
		aria-labelledby="workbench-v2-edit-profile-title"
	>
		<div class="w-full max-w-md rounded-2xl border border-border bg-card p-5 shadow-2xl">
			<div class="mb-4 flex flex-col items-center gap-2">
				<span id="workbench-v2-edit-profile-avatar" class="flex h-14 w-14 items-center justify-center rounded-2xl bg-fuchsia-500/90 text-lg font-semibold text-white">B</span>
				<h2 id="workbench-v2-edit-profile-title" class="sr-only">Edit Profile</h2>
			</div>
			<label class="mb-3 block space-y-1">
				<span class="text-xs text-muted-foreground">Name</span>
				<input id="workbench-v2-edit-profile-name" type="text" value="Bot" class="w-full rounded-lg border border-border bg-muted/40 px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-ring"/>
			</label>
			<label class="mb-3 block space-y-1">
				<span class="text-xs text-muted-foreground">Label (optional)</span>
				<input id="workbench-v2-edit-profile-label" type="text" placeholder="Research, marketing, admin" class="w-full rounded-lg border border-border bg-muted/40 px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring"/>
			</label>
			<label class="mb-4 block space-y-1">
				<span class="text-xs text-muted-foreground">Description</span>
				<textarea id="workbench-v2-edit-profile-description" rows="5" class="w-full rounded-lg border border-border bg-muted/40 px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-ring">Vamos sketch agent profile. Stub description for AI-470 Edit Profile sheet.</textarea>
			</label>
			<div class="mb-4 flex items-center justify-between gap-3 rounded-xl border border-border bg-muted/20 px-3 py-3">
				<div class="min-w-0">
					<p class="text-sm font-medium text-foreground">Notifications</p>
					<p class="text-xs text-muted-foreground">Get notified when this Bot finishes or needs input</p>
				</div>
				<button type="button" id="workbench-v2-edit-profile-notify" class="relative h-6 w-11 shrink-0 rounded-full bg-muted" aria-pressed="false" aria-label="Notifications">
					<span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white transition-transform"></span>
				</button>
			</div>
			<div class="flex justify-end gap-2">
				<button type="button" id="workbench-v2-edit-profile-close" class="rounded-lg px-3 py-1.5 text-sm text-muted-foreground hover:bg-muted/50">Close</button>
				<button type="button" id="workbench-v2-edit-profile-save" class="rounded-lg bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground">Save</button>
			</div>
		</div>
	</div>
}
